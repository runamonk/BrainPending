<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MyNotes"
        xmlns:rte="using:AvaloniaRichEditor.Controls"
        x:Class="MyNotes.MainWindow"
        Icon="/Assets/MyNotes.ico"
        Title="MyNotes" Width="1240" Height="820" MinWidth="850" MinHeight="550"
        Background="{DynamicResource AppSurfaceBrush}">
  <Grid RowDefinitions="*,36">
    <Grid x:Name="WorkspaceGrid" ColumnDefinitions="300,5,*" ClipToBounds="True">
      <Button x:Name="SidebarReveal" Grid.ColumnSpan="3" ZIndex="1" IsVisible="False" Width="15" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Stretch" AutomationProperties.Name="Show sidebar" PointerEntered="SidebarReveal_PointerEntered" PointerExited="Sidebar_PointerExited" Click="SidebarReveal_Click">
        <Button.Template>
          <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
        </Button.Template>
      </Button>
      <Border x:Name="Sidebar" ZIndex="2" Background="{DynamicResource AppSurfaceBrush}" Padding="16,22,16,12" PointerEntered="Sidebar_PointerEntered" PointerExited="Sidebar_PointerExited">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="Search titles in this folder…" CornerRadius="7" FontSize="13" TextChanged="Search_Changed" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Notebook home" AutomationProperties.Name="Notebook home" Click="Home_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 1,9 L 10,2 L 19,9 M 4,7 L 4,18 L 8,18 L 8,12 L 12,12 L 12,18 L 16,18 L 16,7" />
            </Button>
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New note (Ctrl+N)" AutomationProperties.Name="New note" Click="NewNote_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 12,18 L 4,18 L 4,2 L 12,2 L 16,6 L 16,10 M 12,2 L 12,6 L 16,6 M 11,15 L 19,15 M 15,11 L 15,19" />
            </Button>
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New folder" AutomationProperties.Name="New folder" Click="NewFolder_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 10,17 L 2,17 L 2,4 L 8,4 L 10,7 L 18,7 L 18,10 M 11,15 L 19,15 M 15,11 L 15,19" />
            </Button>
            <Button x:Name="SwitchNoteButton" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Switch note (Ctrl+Shift+O)" AutomationProperties.Name="Switch note" Click="SwitchNote_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 9,18 L 3,18 L 3,2 L 15,2 L 15,7 M 6,2 L 6,18 M 14,9 A 4,4 0 1 0 14,17 A 4,4 0 1 0 14,9 M 17,16 L 20,19" />
            </Button>
          </StackPanel>
            <Button x:Name="SidebarPin" Grid.Column="1" Classes="quiet" HorizontalAlignment="Right" Width="32" Height="32" Padding="6" Click="SidebarPin_Click">
              <Grid Width="20" Height="20">
                <Path x:Name="SidebarPinnedFill" Fill="{DynamicResource AppTextBrush}" Opacity="0.3" Data="M 2,3 L 7,3 L 7,17 L 2,17 Z" />
                <Path Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.5" StrokeJoin="Round" Data="M 2,3 L 18,3 L 18,17 L 2,17 Z M 7,3 L 7,17" />
              </Grid>
            </Button>
          </Grid>
          <Grid Grid.Row="2" ClipToBounds="True">
            <ListBox x:Name="Browser" Background="Transparent" SelectionChanged="Browser_SelectionChanged" AutomationProperties.Name="Folders and notes">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:BrowserItem">
                  <Grid ColumnDefinitions="28,*,Auto" MinHeight="28" Background="Transparent">
                    <Path Data="{Binding IconData}" Width="20" Height="20" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="{Binding Path}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Path Grid.Column="2" IsVisible="{Binding IsPinned}" Width="16" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1.4" ToolTip.Tip="Pinned note" Data="M 5,2 L 11,2 M 6,2 L 6,7 L 3,11 L 13,11 L 10,7 L 10,2 M 8,11 L 8,17" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="FolderEmpty" IsVisible="False" IsHitTestVisible="False" Opacity="0.5" Margin="12,50,50,30" TextWrapping="Wrap" />
          </Grid>
          <TextBlock x:Name="ItemCount" Grid.Row="3" FontSize="11" Opacity="0.5" Margin="10,14,0,0" />
        </Grid>
      </Border>
      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Background="{DynamicResource AppLineBrush}" ResizeDirection="Columns" />
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,0,0,1" Padding="28,20,28,18">
          <Grid RowDefinitions="Auto,Auto,Auto">
            <TextBlock x:Name="Breadcrumb" Text="Your notebook" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="NoteTitle" Grid.Row="1" Text="" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" DoubleTapped="NoteTitle_DoubleTapped" ToolTip.Tip="Double-click to rename" />
            <TextBox x:Name="NoteTitleInput" Grid.Row="1" IsVisible="False" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0,0,0,1" KeyDown="NoteTitleInput_KeyDown" LostFocus="NoteTitleInput_LostFocus" AutomationProperties.Name="Note title" />
            <TextBlock x:Name="NoteTitleError" Grid.Row="2" IsVisible="False" Foreground="{DynamicResource AppErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
          </Grid>
        </Border>
        <DockPanel Grid.Row="1">
          <Border x:Name="FindPanel" DockPanel.Dock="Top" Height="0" ClipToBounds="True" IsVisible="False" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="16,8" MinHeight="34">
              <TextBox x:Name="FindInput" PlaceholderText="Find in note…" AutomationProperties.Name="Find in note" TextChanged="FindInput_Changed" />
              <TextBlock x:Name="FindCount" Grid.Column="1" MinWidth="75" Margin="12,0" VerticalAlignment="Center" Text="0 matches" />
              <Button x:Name="FindPrevious" Grid.Column="2" Classes="quiet findNavigation" Content="↑" ToolTip.Tip="Previous match (Shift+F3)" AutomationProperties.Name="Previous match" Click="FindPrevious_Click" />
              <Button x:Name="FindNextButton" Grid.Column="3" Classes="quiet findNavigation" Content="↓" ToolTip.Tip="Next match (F3)" AutomationProperties.Name="Next match" Click="FindNext_Click" />
              <Button Grid.Column="4" Classes="quiet" Content="×" ToolTip.Tip="Close find (Escape)" AutomationProperties.Name="Close find" Click="CloseFind_Click" />
            </Grid>
          </Border>
          <rte:RichEditorView x:Name="EditorView" IsVisible="False" ShowFileActions="False" ShowStatusBar="True" Background="Transparent" />
        </DockPanel>
        <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Spacing="16" Margin="32">
          <TextBlock Text="" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Pick a note on the left, or start something new. " TextWrapping="Wrap" TextAlignment="Center" FontSize="15" Opacity="0.6" LineHeight="25" />
          <Button Content="＋  Write a note" Classes="action" HorizontalAlignment="Center" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentTextBrush}" Click="NewNote_Click" Margin="0,8,0,0" />
          <TextBlock Text="Ctrl+N  new note     •     Ctrl+S  save" FontSize="12" Opacity="0.45" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="Notice" Grid.Row="2" Background="{DynamicResource AppNoticeBrush}" Padding="16,12" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="NoticeText" Foreground="{DynamicResource AppNoticeTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Dismiss" Classes="quiet" Foreground="{DynamicResource AppNoticeTextBrush}" Click="Dismiss_Click" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <SplitButton Grid.Column="1" x:Name="OpenNotebookButton" Click="OpenNotebook_Click" Background="Transparent" BorderThickness="0" CornerRadius="4" Height="30" Padding="8,3" FontSize="11" HorizontalAlignment="Left" HorizontalContentAlignment="Left" ToolTip.Tip="Open notebook" AutomationProperties.Name="Open notebook">
          <TextBlock x:Name="NotebookPath" Text="Open notebook" TextTrimming="CharacterEllipsis" />
        </SplitButton>
        <TextBlock x:Name="SaveStatus" Grid.Column="2" Text="Ready" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="16,0" />
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button x:Name="AppearanceButton" Classes="quiet" Width="30" Height="30" Padding="5" ToolTip.Tip="Color theme" AutomationProperties.Name="Color theme" Click="Theme_Click">
            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                  Data="M 10,1 C 5,1 1,5 1,10 C 1,15 5,19 10,19 C 12,19 13,18 12,16 C 11,14 12,13 14,13 L 16,13 C 18,13 19,12 19,10 C 19,5 15,1 10,1 Z M 6,6 A 1,1 0 1 0 6,8 A 1,1 0 1 0 6,6 M 10,4 A 1,1 0 1 0 10,6 A 1,1 0 1 0 10,4 M 14,6 A 1,1 0 1 0 14,8 A 1,1 0 1 0 14,6 M 5,11 A 1,1 0 1 0 5,13 A 1,1 0 1 0 5,11" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
