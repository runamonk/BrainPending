<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:BrainPending"
        xmlns:rte="using:AvaloniaRichEditor.Controls"
        x:Class="BrainPending.MainWindow"
        Icon="/Assets/BrainPending.ico"
        Title="Brain Pending" Width="1240" Height="820" MinWidth="850" MinHeight="550" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppSurfaceBrush}">
  <Grid RowDefinitions="*,36">
    <Grid x:Name="WorkspaceGrid" ColumnDefinitions="300,1,*" ClipToBounds="True">
      <Border x:Name="MiniSidebar" ZIndex="3" IsVisible="False" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,0,1,0">
        <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="6">
          <Button x:Name="SidebarReveal" IsVisible="False" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Show sidebar" AutomationProperties.Name="Show sidebar" PointerExited="Sidebar_PointerExited" Click="SidebarReveal_Click">
            <Path Width="20" Height="20" Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.5" Data="M 2,3 L 18,3 L 18,17 L 2,17 Z M 7,3 L 7,17" />
          </Button>
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New thought (Ctrl+N)" AutomationProperties.Name="New thought" Click="NewThought_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 5,13 C 2,13 1,11 1,9 C 1,7 2,5 5,5 C 5,1 11,1 12,4 C 16,2 19,5 19,8 C 19,11 17,13 14,13 Z M 8,15.5 A 1.5,1.5 0 1 0 5,15.5 A 1.5,1.5 0 1 0 8,15.5 M 3,18.5 A 0.5,0.5 0 1 0 2,18.5 A 0.5,0.5 0 1 0 3,18.5 M 12,16 L 18,16 M 15,13 L 15,19" />
            </Button>
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New cluster (Ctrl+D)" AutomationProperties.Name="New cluster" Click="NewCluster_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 8,8 L 5.5,5.5 M 12,8 L 14.5,5.5 M 8,12 L 5.5,14.5 M 13,10 A 3,3 0 1 0 7,10 A 3,3 0 1 0 13,10 M 6,4 A 2,2 0 1 0 2,4 A 2,2 0 1 0 6,4 M 18,4 A 2,2 0 1 0 14,4 A 2,2 0 1 0 18,4 M 6,16 A 2,2 0 1 0 2,16 A 2,2 0 1 0 6,16 M 13,16 L 19,16 M 16,13 L 16,19" />
            </Button>
            <Button x:Name="MiniImportThoughtsButton" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Import thoughts" AutomationProperties.Name="Import thoughts" Click="ImportThoughts_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 10,1 L 10,13 M 5,8 L 10,13 L 15,8 M 2,13 L 2,19 L 18,19 L 18,13" />
            </Button>
            <Button x:Name="MiniSwitchThoughtButton" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Quick switch (Ctrl+Shift+O)" AutomationProperties.Name="Quick switch" Click="SwitchThought_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 3,6 L 17,6 M 13,2 L 17,6 L 13,10 M 17,14 L 3,14 M 7,10 L 3,14 L 7,18" />
            </Button>
            <Button x:Name="MiniSearchThoughtsButton" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Search inside thoughts (Ctrl+Shift+G)" AutomationProperties.Name="Search thoughts" Click="SearchThoughts_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 14,8 A 6,6 0 1 0 2,8 A 6,6 0 1 0 14,8 M 12.5,12.5 L 18.5,18.5 M 5.6,8 A 0.6,0.6 0 1 0 4.4,8 A 0.6,0.6 0 1 0 5.6,8 M 8.6,8 A 0.6,0.6 0 1 0 7.4,8 A 0.6,0.6 0 1 0 8.6,8 M 11.6,8 A 0.6,0.6 0 1 0 10.4,8 A 0.6,0.6 0 1 0 11.6,8" />
            </Button>
        </StackPanel>
      </Border>
      <Border x:Name="Sidebar" ZIndex="2" Background="{DynamicResource AppSurfaceBrush}" Padding="16,22,16,12" PointerEntered="Sidebar_PointerEntered" PointerExited="Sidebar_PointerExited">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="Search titles in this cluster…" CornerRadius="7" FontSize="13" TextChanged="Search_Changed" />
          <Grid x:Name="SidebarToolbar" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="SidebarHome" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Brain home" AutomationProperties.Name="Brain home" Click="Home_Click">
                <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 1,9 L 10,2 L 19,9 M 4,7 L 4,18 L 8,18 L 8,12 L 12,12 L 12,18 L 16,18 L 16,7" />
              </Button>
              <StackPanel x:Name="SidebarPinnedActions" Orientation="Horizontal" Spacing="6">
                <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New thought (Ctrl+N)" AutomationProperties.Name="New thought" Click="NewThought_Click">
                  <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 5,13 C 2,13 1,11 1,9 C 1,7 2,5 5,5 C 5,1 11,1 12,4 C 16,2 19,5 19,8 C 19,11 17,13 14,13 Z M 8,15.5 A 1.5,1.5 0 1 0 5,15.5 A 1.5,1.5 0 1 0 8,15.5 M 3,18.5 A 0.5,0.5 0 1 0 2,18.5 A 0.5,0.5 0 1 0 3,18.5 M 12,16 L 18,16 M 15,13 L 15,19" />
                </Button>
                <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New cluster (Ctrl+D)" AutomationProperties.Name="New cluster" Click="NewCluster_Click">
                  <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 8,8 L 5.5,5.5 M 12,8 L 14.5,5.5 M 8,12 L 5.5,14.5 M 13,10 A 3,3 0 1 0 7,10 A 3,3 0 1 0 13,10 M 6,4 A 2,2 0 1 0 2,4 A 2,2 0 1 0 6,4 M 18,4 A 2,2 0 1 0 14,4 A 2,2 0 1 0 18,4 M 6,16 A 2,2 0 1 0 2,16 A 2,2 0 1 0 6,16 M 13,16 L 19,16 M 16,13 L 16,19" />
                </Button>
                <Button x:Name="ImportThoughtsButton" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Import thoughts" AutomationProperties.Name="Import thoughts" Click="ImportThoughts_Click">
                  <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 10,1 L 10,13 M 5,8 L 10,13 L 15,8 M 2,13 L 2,19 L 18,19 L 18,13" />
                </Button>
                <Button x:Name="SwitchThoughtButton" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Quick switch (Ctrl+Shift+O)" AutomationProperties.Name="Quick switch" Click="SwitchThought_Click">
                  <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 3,6 L 17,6 M 13,2 L 17,6 L 13,10 M 17,14 L 3,14 M 7,10 L 3,14 L 7,18" />
                </Button>
                <Button x:Name="SearchThoughtsButton" Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Search inside thoughts (Ctrl+Shift+G)" AutomationProperties.Name="Search thoughts" Click="SearchThoughts_Click">
                  <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 14,8 A 6,6 0 1 0 2,8 A 6,6 0 1 0 14,8 M 12.5,12.5 L 18.5,18.5 M 5.6,8 A 0.6,0.6 0 1 0 4.4,8 A 0.6,0.6 0 1 0 5.6,8 M 8.6,8 A 0.6,0.6 0 1 0 7.4,8 A 0.6,0.6 0 1 0 8.6,8 M 11.6,8 A 0.6,0.6 0 1 0 10.4,8 A 0.6,0.6 0 1 0 11.6,8" />
                </Button>
              </StackPanel>
            </StackPanel>
            <Button x:Name="SidebarPin" Grid.Column="1" Classes="quiet" HorizontalAlignment="Right" Width="32" Height="32" Padding="6" Click="SidebarPin_Click">
              <Grid x:Name="SidebarPinIcon" Width="20" Height="20" RenderTransformOrigin="50%,50%">
                <Path x:Name="SidebarPinnedFill" Fill="{DynamicResource AppTextBrush}" Opacity="0.3" Data="M 7,2 L 13,2 L 13,8 L 16,13 L 4,13 L 7,8 Z" />
                <Path Stroke="{DynamicResource AppTextBrush}" StrokeThickness="1.5" StrokeJoin="Round" Data="M 6,2 L 14,2 M 7,2 L 7,8 L 4,13 L 16,13 L 13,8 L 13,2 M 10,13 L 10,19" />
              </Grid>
            </Button>
          </Grid>
          <Grid Grid.Row="2" ClipToBounds="True">
            <ListBox x:Name="Browser" Background="Transparent" SelectionChanged="Browser_SelectionChanged" AutomationProperties.Name="Clusters and thoughts">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:BrowserItem">
                  <Grid ColumnDefinitions="28,*,Auto" MinHeight="28" Background="Transparent">
                    <Path Data="{Binding IconData}" Width="20" Height="20" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="{Binding Path}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Path Grid.Column="2" IsVisible="{Binding IsPinned}" Width="16" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1.4" ToolTip.Tip="Pinned thought" Data="M 5,2 L 11,2 M 6,2 L 6,7 L 3,11 L 13,11 L 10,7 L 10,2 M 8,11 L 8,17" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ClusterEmpty" IsVisible="False" IsHitTestVisible="False" Opacity="0.5" Margin="12,50,50,30" TextWrapping="Wrap" />
          </Grid>
          <TextBlock x:Name="ItemCount" Grid.Row="3" FontSize="11" Opacity="0.5" Margin="10,14,0,0" />
        </Grid>
      </Border>
      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" ZIndex="4" Width="7" Margin="-3,0" Background="{DynamicResource AppLineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext">
        <GridSplitter.Template>
          <ControlTemplate>
            <Grid Background="Transparent">
              <Border Width="1" HorizontalAlignment="Center" Background="{TemplateBinding Background}" />
            </Grid>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <Border x:Name="ThoughtHeader" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,2">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <Image Grid.Column="1" Grid.RowSpan="3" Source="/Assets/BrainPending.png" Width="64" Height="64" Margin="12,-18,0,0" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock x:Name="Breadcrumb" Text="Your brain" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ThoughtTitle" Grid.Row="1" Text="" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" DoubleTapped="ThoughtTitle_DoubleTapped" ToolTip.Tip="Double-click to rename" />
            <TextBox x:Name="ThoughtTitleInput" Grid.Row="1" IsVisible="False" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" Padding="0" Background="Transparent" BorderThickness="0,0,0,1" KeyDown="ThoughtTitleInput_KeyDown" LostFocus="ThoughtTitleInput_LostFocus" AutomationProperties.Name="Thought title" />
            <TextBlock x:Name="ThoughtTitleError" Grid.Row="2" IsVisible="False" Foreground="{DynamicResource AppErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
          </Grid>
        </Border>
        <DockPanel Grid.Row="1">
          <Border x:Name="FindPanel" DockPanel.Dock="Top" Height="0" ClipToBounds="True" IsVisible="False" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="16,8" MinHeight="34">
              <TextBox x:Name="FindInput" PlaceholderText="Find in thought…" AutomationProperties.Name="Find in thought" TextChanged="FindInput_Changed" />
              <TextBlock x:Name="FindCount" Grid.Column="1" MinWidth="75" Margin="12,0" VerticalAlignment="Center" Text="0 matches" />
              <Button x:Name="FindPrevious" Grid.Column="2" Classes="quiet findNavigation" Content="↑" ToolTip.Tip="Previous match (Shift+F3)" AutomationProperties.Name="Previous match" Click="FindPrevious_Click" />
              <Button x:Name="FindNextButton" Grid.Column="3" Classes="quiet findNavigation" Content="↓" ToolTip.Tip="Next match (F3)" AutomationProperties.Name="Next match" Click="FindNext_Click" />
              <Button Grid.Column="4" Classes="quiet" Content="×" ToolTip.Tip="Close find (Escape)" AutomationProperties.Name="Close find" Click="CloseFind_Click" />
            </Grid>
          </Border>
          <rte:RichEditorView x:Name="EditorView" IsVisible="False" ShowFileActions="False" ShowStatusBar="True" Background="Transparent" />
        </DockPanel>
        <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Spacing="16" Margin="32">
          <TextBlock Text="" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Pick a thought on the left, or start something new. " TextWrapping="Wrap" TextAlignment="Center" FontSize="15" Opacity="0.6" LineHeight="25" />
          <Button Content="＋  Write a thought" Classes="action" HorizontalAlignment="Center" Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppAccentTextBrush}" Click="NewThought_Click" Margin="0,8,0,0" />
          <TextBlock Text="Ctrl+N  new thought     •     Ctrl+S  save" FontSize="12" Opacity="0.45" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="Notice" Grid.Row="2" Background="{DynamicResource AppNoticeBrush}" Padding="16,12" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock x:Name="NoticeText" Foreground="{DynamicResource AppNoticeTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="RetrySaveButton" Grid.Column="1" Content="Save again" IsVisible="False" Classes="action" ToolTip.Tip="Save thought (Ctrl+S)" Click="RetrySave_Click" Margin="12,0,8,0" />
            <Button Grid.Column="2" Content="Dismiss" Classes="quiet" Foreground="{DynamicResource AppNoticeTextBrush}" Click="Dismiss_Click" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <SplitButton Grid.Column="1" x:Name="OpenBrainButton" Click="OpenBrain_Click" Background="Transparent" BorderThickness="0" CornerRadius="4" Height="30" Padding="8,3" FontSize="11" HorizontalAlignment="Left" HorizontalContentAlignment="Left" ToolTip.Tip="Open brain" AutomationProperties.Name="Open brain">
          <TextBlock x:Name="BrainPath" Text="Open brain" TextTrimming="CharacterEllipsis" />
        </SplitButton>
        <TextBlock x:Name="SaveStatus" Grid.Column="2" Text="Ready" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="16,0" />
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button x:Name="AppearanceButton" Classes="quiet" Width="30" Height="30" Padding="5" ToolTip.Tip="Color theme" AutomationProperties.Name="Color theme" Click="Theme_Click">
            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                  Data="M 10,1 C 5,1 1,5 1,10 C 1,15 5,19 10,19 C 12,19 13,18 12,16 C 11,14 12,13 14,13 L 16,13 C 18,13 19,12 19,10 C 19,5 15,1 10,1 Z M 6,6 A 1,1 0 1 0 6,8 A 1,1 0 1 0 6,6 M 10,4 A 1,1 0 1 0 10,6 A 1,1 0 1 0 10,4 M 14,6 A 1,1 0 1 0 14,8 A 1,1 0 1 0 14,6 M 5,11 A 1,1 0 1 0 5,13 A 1,1 0 1 0 5,11" />
          </Button>
          <Button x:Name="UpdateButton" Classes="quiet" Width="30" Height="30" Padding="5" ToolTip.Tip="Check for updates" AutomationProperties.Name="Check for updates" Click="CheckForUpdates_Click">
            <Path Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                  Data="M 17,10 A 7,7 0 1 1 14.95,5.05 M 11,5.05 L 14.95,5.05 L 14.95,1.1" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
