<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MyNotes"
        xmlns:rte="using:AvaloniaRichEditor.Controls"
        x:Class="MyNotes.MainWindow"
        Title="MyNotes" Width="1240" Height="820" MinWidth="850" MinHeight="550"
        Background="{DynamicResource AppSurfaceBrush}">
  <Grid RowDefinitions="64,*,36">
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="22,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="#526B59" CornerRadius="9" Width="32" Height="32">
            <TextBlock Text="N" Foreground="White" FontWeight="SemiBold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MyNotes" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="A little space for your thoughts." Opacity="0.55" Margin="24,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <SplitButton x:Name="OpenNotebookButton" Content="Open notebook" Click="OpenNotebook_Click" Background="Transparent" CornerRadius="7" FontSize="13" AutomationProperties.Name="Open notebook" />
          <Button Classes="action quiet" Content="◐" ToolTip.Tip="Switch light / dark theme" AutomationProperties.Name="Switch theme" Click="Theme_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="300,5,*">
      <Border Background="{DynamicResource AppSurfaceBrush}" Padding="16,22,16,12">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <TextBlock x:Name="FolderHeading" IsVisible="False" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
          <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search titles in this folder…" CornerRadius="7" FontSize="13" TextChanged="Search_Changed" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,6">
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="Notebook home" AutomationProperties.Name="Notebook home" Click="Home_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 1,9 L 10,2 L 19,9 M 4,7 L 4,18 L 8,18 L 8,12 L 12,12 L 12,18 L 16,18 L 16,7" />
            </Button>
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New note (Ctrl+N)" AutomationProperties.Name="New note" Click="NewNote_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 12,18 L 4,18 L 4,2 L 12,2 L 16,6 L 16,10 M 12,2 L 12,6 L 16,6 M 11,15 L 19,15 M 15,11 L 15,19" />
            </Button>
            <Button Classes="quiet" Width="32" Height="32" Padding="6" ToolTip.Tip="New folder" AutomationProperties.Name="New folder" Click="NewFolder_Click">
              <Path Width="20" Height="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M 10,17 L 2,17 L 2,4 L 8,4 L 10,7 L 18,7 L 18,10 M 11,15 L 19,15 M 15,11 L 15,19" />
            </Button>
          </StackPanel>
          <Grid Grid.Row="3" ClipToBounds="True">
            <ListBox x:Name="Browser" Background="Transparent" SelectionChanged="Browser_SelectionChanged" AutomationProperties.Name="Folders and notes">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:BrowserItem">
                  <Grid ColumnDefinitions="28,*,Auto" MinHeight="28" Background="Transparent">
                    <Path Data="{Binding IconData}" Width="20" Height="20" Stroke="#789481" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="{Binding Path}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Path Grid.Column="2" IsVisible="{Binding IsPinned}" Width="16" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Stroke="#789481" StrokeThickness="1.4" ToolTip.Tip="Pinned note" Data="M 5,2 L 11,2 M 6,2 L 6,7 L 3,11 L 13,11 L 10,7 L 10,2 M 8,11 L 8,17" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="FolderEmpty" IsVisible="False" Opacity="0.5" Margin="12,30" TextWrapping="Wrap" />
          </Grid>
          <TextBlock x:Name="ItemCount" Grid.Row="4" FontSize="11" Opacity="0.5" Margin="10,14,0,0" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" ResizeDirection="Columns" />
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Padding="28,20,28,18">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Breadcrumb" Text="Your notebook" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="NoteTitle" Grid.Row="1" Text="Make room for an idea." FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <Button x:Name="RenameNoteButton" Grid.Column="1" Grid.RowSpan="2" Classes="action quiet" Content="Rename" VerticalAlignment="Center" Click="RenameNote_Click" IsVisible="False" />
          </Grid>
        </Border>
        <rte:RichEditorView Grid.Row="1" x:Name="EditorView" IsVisible="False" ShowFileActions="False" ShowStatusBar="True" Background="Transparent" />
        <StackPanel x:Name="Welcome" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Spacing="16" Margin="32">
          <TextBlock Text="Your ideas, at home." FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Pick a note on the left, or start something new. Everything lives in your notebook folder." TextWrapping="Wrap" TextAlignment="Center" FontSize="15" Opacity="0.6" LineHeight="25" />
          <Button Content="＋  Write a note" Classes="action" HorizontalAlignment="Center" Background="#526B59" Foreground="White" Click="NewNote_Click" Margin="0,8,0,0" />
          <TextBlock Text="Ctrl+N  new note     •     Ctrl+S  save" FontSize="12" Opacity="0.45" HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="Notice" Grid.Row="2" Background="#FFF0CA" Padding="16,12" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="NoticeText" Foreground="#594718" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Dismiss" Classes="quiet" Foreground="#594718" Click="Dismiss_Click" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock x:Name="NotebookPath" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SaveStatus" Grid.Column="1" Text="Ready" FontSize="11" Opacity="0.7" />
      </Grid>
    </Border>
  </Grid>
</Window>
