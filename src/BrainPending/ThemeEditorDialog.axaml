<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="using:AvaloniaRichEditor.Controls"
        x:Class="BrainPending.ThemeEditorDialog"
        Title="Edit themes" Width="1040" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Spacing="5" Margin="0,0,0,16">
      <TextBlock Text="Edit themes" FontSize="23" />
      <TextBlock Text="Edit colors or duplicate a theme with a new name. Preview changes before saving." TextWrapping="Wrap" Opacity="0.7" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="3*,10,2*">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="themes.json" Margin="0,0,0,8" />
        <TextBox x:Name="JsonEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Theme JSON" TextChanged="Json_Changed" />
      </Grid>
      <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" ResizeDirection="Columns" />
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
        <TextBlock Text="Preview" Margin="0,0,0,8" />
        <ComboBox x:Name="ThemeChoice" Grid.Row="1" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Preview theme" SelectionChanged="Theme_Changed" Margin="0,0,0,12" />
        <Border x:Name="PreviewSurface" Grid.Row="2" BorderThickness="1" CornerRadius="8" Padding="16">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock x:Name="PreviewIcon" Text="✎" FontSize="24" />
              <TextBlock x:Name="PreviewTitle" Grid.Column="1" Text="A thought of your own" FontSize="20" TextWrapping="Wrap" />
            </Grid>
            <Border x:Name="PreviewSelection" Grid.Row="1" Padding="10" CornerRadius="4">
              <TextBlock x:Name="PreviewSelectedText" Text="Selected thought" />
            </Border>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
              <editor:RichEditor x:Name="PreviewEditor" IsReadOnly="True" DefaultFontSize="12" />
            </ScrollViewer>
            <Border x:Name="PreviewAccent" Grid.Row="3" Padding="12,8" CornerRadius="6" HorizontalAlignment="Left">
              <TextBlock x:Name="PreviewAccentText" Text="Write a thought" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <TextBlock x:Name="ValidationMessage" Grid.Row="2" Margin="0,12" TextWrapping="Wrap" MaxHeight="75" />
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="Ctrl+S to save · Esc to cancel" VerticalAlignment="Center" Opacity="0.6" />
      <Button Grid.Column="1" Content="Cancel" Classes="action quiet" IsCancel="True" Click="Cancel_Click" />
      <Button x:Name="SaveButton" Grid.Column="2" Content="Save themes" Classes="action primary" Click="Save_Click" />
    </Grid>
  </Grid>
</Window>
